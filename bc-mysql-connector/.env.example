# ---- Business Central ----------------------------------------------------
# mock  = local mock BC API (no Microsoft account needed)
# entra = real Business Central via Microsoft Entra client credentials
BC_AUTH_MODE=mock
BC_BASE_URL=http://127.0.0.1:8765
BC_TENANT_ID=
BC_ENVIRONMENT=Production
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_COMPANY_ID=
BC_ENTITIES=customers,vendors,items,salesOrders

# ---- MySQL ---------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=bc_sync
MYSQL_USER=bcsync
MYSQL_PASSWORD=change-me

# ---- Sync ----------------------------------------------------------------
SYNC_INTERVAL_SECONDS=300
PUSH_MAX_ATTEMPTS=5

# local docker test container only
MYSQL_ROOT_PASSWORD=change-me
